---
import Baselayout from '../layouts/base.astro';

const videoSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "VideoObject",
      "name": "Greenwater Gray Water System Architecture Walkthrough",
      "description": "How the Greenwater gray water system connects to existing shower and sink drain lines, identifies reclaimable gray water in real time, and routes it through three-stage filtration to the garden.",
      "contentUrl": "https://cdn.hackclub.com/019d44ca-a694-74e6-803b-5107cbe8578b/Water%20Wise%20Mk.%201%20v12.mp4",
      "uploadDate": "2026-03-31"
    },
    {
      "@type": "VideoObject",
      "name": "Greenwater AI-Driven Greywater Filtration Demonstration",
      "description": "Greenwater's AI models running on embedded sensors, monitoring water quality at every filtration stage and adjusting diversion valves automatically.",
      "contentUrl": "https://cdn.hackclub.com/019d3cf1-df73-7afb-a776-a0b14ffc0703/video.mp4",
      "uploadDate": "2026-03-30"
    }
  ]
};
---

<Baselayout
  title="Product Demo – See the Gray Water System in Action"
  description="Watch Greenwater's AI-powered gray water (greywater) recycling hardware and filtration system in action. See how it installs in under a day with no full replumbing."
  canonical="https://waterwz.com/demo/"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
	<section class="demo-wrap">
		<p class="eyebrow">Product Demo</p>
		<h1>See the Greenwater gray water system in action</h1>
		<h2>System Architecture</h2>
		<p class="demo-desc">The Greenwater gray water system connects directly to your existing shower and sink drain lines. Our valve pack identifies reclaimable gray water in real-time, routes it through a three-stage filtration process, and delivers clean water to your garden — without touching black water lines or requiring full replumbing.</p>

		<div class="video-slot" aria-label="Greenwater gray water system architecture walkthrough video">
			<video controls preload="metadata" playsinline>
				<source
					src="https://cdn.hackclub.com/019d44ca-a694-74e6-803b-5107cbe8578b/Water%20Wise%20Mk.%201%20v12.mp4"
					type="video/mp4"
				/>
				Your browser does not support the video tag.
			</video>
		</div>
	</section>
	<section class="demo-wrap">
		<h2>AI in action</h2>
		<p class="demo-desc">Greenwater's AI models run continuously on embedded sensors throughout the greywater system. The AI monitors water quality at every filtration stage, adjusting diversion valves and filtration parameters to ensure every drop meets safety thresholds before reaching your garden. No manual tuning required.</p>

		<div class="video-slot" aria-label="Greenwater AI-driven greywater filtration system demonstration video">
			<video controls preload="metadata" playsinline>
				<source
					src="https://cdn.hackclub.com/019d3cf1-df73-7afb-a776-a0b14ffc0703/video.mp4"
					type="video/mp4"
				/>
				Your browser does not support the video tag.
			</video>
		</div>
	</section>

	<style>
		.demo-wrap {
			max-width: 960px;
			margin: 6rem auto 1rem;
			padding: clamp(1rem, 3vw, 2rem);
			background: color-mix(in srgb, var(--gw-cream) 80%, white);
			border: 1px solid color-mix(in srgb, var(--gw-olive) 24%, transparent);
			border-radius: 1rem;
			box-shadow: 0 12px 28px rgba(40, 54, 24, 0.12);
		}

		.eyebrow {
			margin: 0;
			font-size: 0.78rem;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--gw-rust);
			font-weight: 700;
		}

		.demo-wrap + .demo-wrap {
			margin-top: 1rem;
		}

		h1, h2 {
			font-family: 'DM Serif Display', serif;
			margin: 0.45rem 0 0.75rem;
			color: var(--gw-forest);
		}

		h1 {
			font-size: clamp(1.8rem, 4vw, 2.4rem);
		}

		h2 {
			font-size: clamp(1.3rem, 2.6vw, 1.7rem);
		}

		.demo-desc {
			font-size: 0.95rem;
			line-height: 1.7;
			color: var(--gw-text-muted);
			margin: 0 0 1rem;
			max-width: 68ch;
		}

		.video-slot {
			width: 100%;
			aspect-ratio: 16 / 9;
			border-radius: 0.9rem;
			border: 2px dashed color-mix(in srgb, var(--gw-sand) 48%, transparent);
			overflow: hidden;
			background:
				radial-gradient(circle at 12% 0%, color-mix(in srgb, var(--gw-sand) 18%, transparent), transparent 52%),
				linear-gradient(145deg, color-mix(in srgb, var(--gw-cream) 90%, white), color-mix(in srgb, var(--gw-cream) 74%, white));
		}

		.video-slot video {
			width: 100%;
			height: 100%;
			display: block;
			object-fit: cover;
		}
	</style>
</Baselayout>
